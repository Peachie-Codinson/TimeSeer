{
  "name": "planner",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:server": "pnpm --filter @planner/server dev",
    "dev:web": "pnpm --filter @planner/web dev",
    "build": "pnpm --filter @planner/scheduler build && pnpm --filter @planner/server build && pnpm --filter @planner/web build",
    "db:generate": "pnpm --filter @planner/server db:generate",
    "db:migrate": "pnpm --filter @planner/server db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
